        <mxCell id="bridge_v" value="&lt;b&gt;V&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeColor=#E2E8F0;strokeWidth=2;fontColor=#E2E8F0;fontSize=16;flowAnimation=1;dashed=1;dashPattern=1 2;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
