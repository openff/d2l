        <mxCell id="ft_ffn" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Feed Forward&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3182CE;strokeColor=none;fontColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="1130" y="540" width="220" height="44" as="geometry" />
        </mxCell>
        <mxCell id="ft_an2" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Add &amp;amp; Norm&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D69E2E;strokeColor=none;fontColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="1130" y="490" width="220" height="36" as="geometry" />
        </mxCell>
        <mxCell id="ft_enc_label" value="&lt;b style=&quot;font-size:13px;color:#48BB78;&quot;&gt;复用预训练 BERTEncoder (权重迁移)&lt;/b&gt;" style="text;html=1;align=center;fontColor=#48BB78;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1070" y="438" width="340" height="24" as="geometry" />
