        <mxCell id="legend_txt" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;GRU Cell&lt;br&gt;Pointwise ops: 〇&lt;br&gt;Neural Net ops: ▭&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#CCCCCC;" parent="1" vertex="1">
          <mxGeometry x="115" y="365" width="90" height="40" as="geometry" />
        </mxCell>
              <mxCell id="note_gru_f" value="&lt;b style=&quot;font-size:16px;color:#F6E05E;&quot;&gt;【 核心公式 】&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;更新门&lt;/b&gt;  Z_t = σ(X_t W_xz + H_(t-1) W_hz + b_z)&lt;br&gt;&lt;br&gt;&lt;b&gt;重置门&lt;/b&gt;  R_t = σ(X_t W_xr + H_(t-1) W_hr + b_r)&lt;br&gt;&lt;br&gt;&lt;b&gt;候选状态&lt;/b&gt;&lt;br&gt;H̃_t = tanh(X_t W_xh + (R_t ⊙ H_(t-1)) W_hh + b_h)&lt;br&gt;&lt;br&gt;&lt;b&gt;最终状态&lt;/b&gt;&lt;br&gt;H_t = Z_t ⊙ H_(t-1) + (1 − Z_t) ⊙ H̃_t&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#A0AEC0;&quot;&gt;σ=sigmoid(0~1), ⊙=按元素乘&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#F6E05E;fillColor=#1A202C;strokeColor=#D69E2E;spacing=12;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="620" y="30" width="420" height="250" as="geometry" />
        </mxCell>
        <mxCell id="note_gru_a" value="&lt;b style=&quot;font-size:16px;color:#68d391;&quot;&gt;【 GRU 核心原理 】&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;两门分工&lt;/b&gt;&lt;br&gt;• 重置门 R_t：算候选时'选择性遗忘'旧信息&lt;br&gt;• 更新门 Z_t：输出时决定'保留旧'还是'接纳新'&lt;br&gt;&lt;br&gt;&lt;b&gt;为什么缓解梯度消失&lt;/b&gt;&lt;br&gt;Z_t⊙H_(t-1) 项像跳跃连接，绕过 tanh，梯度可直通历史步；当 Z_t≈1 时 H_t≈H_(t-1)，长期记忆得以保留&lt;br&gt;&lt;br&gt;&lt;b&gt;直觉(凸组合)&lt;/b&gt;&lt;br&gt;H_t = 旧记忆路 + 新信息路，权重互补(和为1)：&lt;br&gt;Z_t高→保留旧(无关输入期)；Z_t低→采纳新(关键转折期)&lt;br&gt;&lt;br&gt;&lt;b&gt;对比&lt;/b&gt;：比普通RNN能选择性记忆；比LSTM少1个门，参数少1/3、更快，效果相近" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#E2E8F0;fillColor=#2D3748;strokeColor=#68d391;spacing=14;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="620" y="300" width="420" height="300" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
