        <mxCell id="ft_mha" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Multi-Head&lt;br&gt;Self-Attention (双向)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DD6B20;strokeColor=none;fontColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="1130" y="660" width="220" height="50" as="geometry" />
