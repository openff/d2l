        <mxCell id="ft_head" value="&lt;b style=&quot;font-size:14px;&quot;&gt;分类头 (新增)&lt;br&gt;Linear(d → 3)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6AD55;strokeColor=#DD6B20;strokeWidth=2;fontColor=#1A202C;" parent="1" vertex="1">
          <mxGeometry x="1150" y="300" width="180" height="50" as="geometry" />
