          </mxGeometry>
        </mxCell>
        <mxCell id="m_note1" value="W&lt;sub&gt;xh&lt;/sub&gt;, W&lt;sub&gt;hh&lt;/sub&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontColor=#AAAAAA;" vertex="1" parent="1">
          <mxGeometry x="500" y="635" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m_e_zoom_left" style="edgeStyle=none;rounded=1;html=1;endArrow=none;dashed=1;strokeWidth=1;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="265" as="sourcePoint" />
            <mxPoint x="330" y="490" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m_e_zoom_right" style="edgeStyle=none;rounded=1;html=1;endArrow=none;dashed=1;strokeWidth=1;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="265" as="sourcePoint" />
            <mxPoint x="690" y="490" as="targetPoint" />
          </mxGeometry>
        </mxCell>
              <mxCell id="note_rnn_f" value="&lt;b style=&quot;font-size:16px;color:#F6E05E;&quot;&gt;【 核心公式 】&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;隐状态递推(循环核心)&lt;/b&gt;&lt;br&gt;H_t = tanh(X_t W_xh + H_(t-1) W_hh + b_h)&lt;br&gt;&lt;span style=&quot;color:#A0AEC0;&quot;&gt;W_hh 是'循环'的本质：把上一步记忆带入当前&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;输出&lt;/b&gt;  O_t = H_t W_hq + b_q&lt;br&gt;&lt;br&gt;&lt;b&gt;困惑度(评价)&lt;/b&gt;  ppl = exp( (1/n) Σ −log p(x_t | …) )&lt;br&gt;&lt;span style=&quot;color:#A0AEC0;&quot;&gt;=平均每步在多少候选词间纠结，1为完美&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;梯度裁剪(防爆炸)&lt;/b&gt;  g ← min(1, θ/‖g‖) · g" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#F6E05E;fillColor=#1A202C;strokeColor=#D69E2E;spacing=12;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="820" y="20" width="440" height="270" as="geometry" />
        </mxCell>
        <mxCell id="note_rnn_a" value="&lt;b style=&quot;font-size:16px;color:#90CDF4;&quot;&gt;【 RNN 核心原理 】&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;隐状态携带历史&lt;/b&gt;&lt;br&gt;H_t 像'记忆容器'，逐步接收当前输入 X_t 与前一记忆 H_(t-1)，把过去信息压缩进一个向量&lt;br&gt;&lt;br&gt;&lt;b&gt;参数跨时间步共享&lt;/b&gt;&lt;br&gt;W_xh, W_hh, W_hq 在所有时刻复用，与序列长度无关&lt;br&gt;&lt;br&gt;&lt;b&gt;折叠 vs 展开&lt;/b&gt;&lt;br&gt;折叠=带自循环的紧凑记号(设计视角)；展开=沿时间轴复制成多步、共享同一组参数(理解梯度反传)&lt;br&gt;&lt;br&gt;&lt;b&gt;梯度消失/爆炸&lt;/b&gt;&lt;br&gt;T 步反传形成 O(T) 长的矩阵乘链，梯度易指数衰减或增长；标配：梯度裁剪 + 截断BPTT(detach 切断计算图)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#E2E8F0;fillColor=#2D3748;strokeColor=#90CDF4;spacing=14;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="820" y="310" width="440" height="320" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
