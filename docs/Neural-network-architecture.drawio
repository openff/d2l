        <mxCell id="ft_cls" value="&lt;b style=&quot;font-size:13px;&quot;&gt;取 &amp;lt;cls&amp;gt; 表示&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D69E2E;strokeColor=none;fontColor=#FFFFFF;" parent="1" vertex="1">
