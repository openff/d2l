        <mxCell id="formula_txt" value="&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#CCCCCC&quot;&gt;&lt;b&gt;核心公式:&lt;/b&gt; h&lt;sub&gt;t&lt;/sub&gt; = tanh(W&lt;sub&gt;hh&lt;/sub&gt; · h&lt;sub&gt;t-1&lt;/sub&gt; + W&lt;sub&gt;xh&lt;/sub&gt; · x&lt;sub&gt;t&lt;/sub&gt; + b&lt;sub&gt;h&lt;/sub&gt;)　　o&lt;sub&gt;t&lt;/sub&gt; = W&lt;sub&gt;ho&lt;/sub&gt; · h&lt;sub&gt;t&lt;/sub&gt; + b&lt;sub&gt;o&lt;/sub&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#CCCCCC;" parent="1" vertex="1">
