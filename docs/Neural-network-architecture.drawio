        <mxCell id="ft_out" value="&lt;font style=&quot;font-size:14px;&quot;&gt;蕴含 / 矛盾 / 中立 (3 类)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="1120" y="240" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="le_in" style="endArrow=classic;html=1;strokeColor=#E2E8F0;strokeWidth=2;flowAnimation=1;dashed=1;dashPattern=1 2;" parent="1" source="pt_in" target="pt_emb" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le_emb" style="endArrow=classic;html=1;strokeColor=#E2E8F0;strokeWidth=2;flowAnimation=1;dashed=1;dashPattern=1 2;" parent="1" source="pt_emb" target="pt_enc_block" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le_mlm" style="endArrow=classic;html=1;strokeColor=#48BB78;strokeWidth=2;flowAnimation=1;dashed=1;dashPattern=1 2;" parent="1" source="pt_enc_block" target="pt_mlm" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le_nsp" style="endArrow=classic;html=1;strokeColor=#805AD5;strokeWidth=2;flowAnimation=1;dashed=1;dashPattern=1 2;" parent="1" source="pt_enc_block" target="pt_nsp" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le_mlmo" style="endArrow=classic;html=1;strokeColor=#E2E8F0;strokeWidth=2;flowAnimation=1;dashed=1;dashPattern=1 2;" parent="1" source="pt_mlm" target="pt_mlm_out" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le_nspo" style="endArrow=classic;html=1;strokeColor=#E2E8F0;strokeWidth=2;flowAnimation=1;dashed=1;dashPattern=1 2;" parent="1" source="pt_nsp" target="pt_nsp_out" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lf_in" style="endArrow=classic;html=1;strokeColor=#E2E8F0;strokeWidth=2;flowAnimation=1;dashed=1;dashPattern=1 2;" parent="1" source="ft_in" target="ft_emb" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lf_emb" style="endArrow=classic;html=1;strokeColor=#E2E8F0;strokeWidth=2;flowAnimation=1;dashed=1;dashPattern=1 2;" parent="1" source="ft_emb" target="ft_enc_block" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lf_cls" style="endArrow=classic;html=1;strokeColor=#E2E8F0;strokeWidth=2;flowAnimation=1;dashed=1;dashPattern=1 2;" parent="1" source="ft_enc_block" target="ft_cls" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lf_head" style="endArrow=classic;html=1;strokeColor=#E2E8F0;strokeWidth=2;flowAnimation=1;dashed=1;dashPattern=1 2;" parent="1" source="ft_cls" target="ft_head" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lf_out" style="endArrow=classic;html=1;strokeColor=#E2E8F0;strokeWidth=2;flowAnimation=1;dashed=1;dashPattern=1 2;" parent="1" source="ft_head" target="ft_out" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="migrate_arrow" value="&lt;b style=&quot;font-size:15px;color:#48BB78;&quot;&gt;迁移：复用编码器权重&lt;br&gt;丢掉 MLM/NSP 头，换分类头&lt;/b&gt;" style="endArrow=classic;html=1;strokeColor=#48BB78;strokeWidth=3;fontColor=#48BB78;curved=1;dashed=0;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="640" y="600" as="sourcePoint" />
            <mxPoint x="1060" y="600" as="targetPoint" />
            <Array as="points">
              <mxPoint x="850" y="430" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="anno_pt" value="&lt;b style=&quot;font-size:16px;color:#48BB78;&quot;&gt;【 预训练 (264) 】&lt;/b&gt;&lt;br&gt;&lt;br&gt;在海量无标注文本上做两个自监督任务：&lt;br&gt;&lt;br&gt;① MLM：随机遮住 15% 的词，让模型根据双向上下文还原原词（完形填空），逼编码器学会词义+语法+常识；&lt;br&gt;&lt;br&gt;② NSP：判断句 B 是否是句 A 的真实下文，逼 &amp;lt;cls&amp;gt; 学会句子对关系。&lt;br&gt;&lt;br&gt;两个任务共享同一个 BERTEncoder，联合损失 = MLM + NSP。预训练完成后，&lt;b style=&quot;color:#F6AD55;&quot;&gt;两个头用完即弃&lt;/b&gt;，保留的是学到通用语言表示的编码器。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#E2E8F0;fillColor=#2D3748;strokeColor=#48BB78;spacing=15;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="240" width="220" height="500" as="geometry" />
        </mxCell>
        <mxCell id="anno_ft" value="&lt;b style=&quot;font-size:16px;color:#F6AD55;&quot;&gt;【 微调 (265) 】&lt;/b&gt;&lt;br&gt;&lt;br&gt;把预训练好的编码器迁移到下游任务（如自然语言推理 NLI）：&lt;br&gt;&lt;br&gt;① 复用 BERTEncoder（加载预训练权重，结构一字未改）；&lt;br&gt;&lt;br&gt;② 丢掉 MLM / NSP 头；&lt;br&gt;&lt;br&gt;③ 取 &amp;lt;cls&amp;gt; 表示，接一个新的分类头 Linear(d→3)；&lt;br&gt;&lt;br&gt;④ 用少量标注数据、&lt;b style=&quot;color:#48BB78;&quot;&gt;小学习率 (1e-4)&lt;/b&gt; 整体微调，避免冲掉已学知识。&lt;br&gt;&lt;br&gt;SNLI 上 bert.small 微调可达约 78% 准确率。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#E2E8F0;fillColor=#2D3748;strokeColor=#F6AD55;spacing=15;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="1440" y="240" width="240" height="500" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
